    {
      "name": "4. Atividades (CRUD)",
      "description": "Cadastro, consulta, alteração e exclusão de atividades agrícolas. Os custos são sempre calculados pelo sistema.",
      "item": [
        {
          "name": "Cadastrar atividade",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Data de hoje no fuso do computador (a API não aceita data futura).",
                  "const d = new Date();",
                  "const hoje = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');",
                  "pm.collectionVariables.set('hoje', hoje);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const atividade = pm.response.json().data;",
                  "pm.collectionVariables.set('atividade_id', atividade.id);",
                  "pm.test('Cabeçalho Location', () => pm.response.to.have.header('Location'));",
                  "pm.test('Custo total calculado', () => pm.expect(atividade.custo_total).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/atividades",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "atividades"
              ]
            },
            "description": "Registra a atividade com os IDs guardados nas pastas anteriores. Responde 201, com o cabeçalho Location e os custos calculados.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propriedade_id\": {{propriedade_id}},\n  \"talhao_id\": {{talhao_id}},\n  \"data\": \"{{hoje}}\",\n  \"tipo\": \"adubacao\",\n  \"descricao\": \"Adubação de cobertura (cadastrada pela API)\",\n  \"insumos\": [{ \"insumo_id\": {{insumo_id}}, \"quantidade\": 250 }],\n  \"maquinas\": [{ \"maquina_id\": {{maquina_id}}, \"horas\": 2.5 }],\n  \"funcionarios\": [{ \"funcionario_id\": {{funcionario_id}}, \"horas\": 3 }],\n  \"implementos\": [{{implemento_id}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Listar atividades",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/atividades?talhao_id={{talhao_id}}&por_pagina=5",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "atividades"
              ],
              "query": [
                {
                  "key": "talhao_id",
                  "value": "{{talhao_id}}"
                },
                {
                  "key": "por_pagina",
                  "value": "5"
                }
              ]
            },
            "description": "Atividades do usuário, das mais recentes para as mais antigas. Filtros: propriedade_id, talhao_id, tipo, busca, por_pagina."
          }
        },
        {
          "name": "Consultar atividade",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/atividades/{{atividade_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "atividades",
                "{{atividade_id}}"
              ]
            },
            "description": "Atividade com os itens e os valores gravados no lançamento (snapshot)."
          }
        },
        {
          "name": "Atualizar atividade",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Data de hoje no fuso do computador (a API não aceita data futura).",
                  "const d = new Date();",
                  "const hoje = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');",
                  "pm.collectionVariables.set('hoje', hoje);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Descrição alterada', () => pm.expect(pm.response.json().data.descricao).to.eql('Adubação corrigida (alterada pela API)'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/atividades/{{atividade_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "atividades",
                "{{atividade_id}}"
              ]
            },
            "description": "Envio completo, como no formulário de edição. Aqui as horas da máquina passam de 2,5 para 4, e o custo é recalculado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"talhao_id\": {{talhao_id}},\n  \"data\": \"{{hoje}}\",\n  \"tipo\": \"adubacao\",\n  \"descricao\": \"Adubação corrigida (alterada pela API)\",\n  \"insumos\": [{ \"insumo_id\": {{insumo_id}}, \"quantidade\": 250 }],\n  \"maquinas\": [{ \"maquina_id\": {{maquina_id}}, \"horas\": 4 }],\n  \"funcionarios\": [{ \"funcionario_id\": {{funcionario_id}}, \"horas\": 3 }],\n  \"implementos\": [{{implemento_id}}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
