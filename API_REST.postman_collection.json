{
  "info": {
    "name": "API REST — Sistema de Controle de Atividades Agrícolas",
    "description": "API REST v1 do TCC (Laravel + MySQL). Documentação completa em API_DOCUMENTATION.md.\n\nComo usar: confira as variáveis da collection (base_url, email, senha), rode '1. Autenticação → Login' e siga as pastas em ordem. O token e os IDs são guardados automaticamente. Com o Collection Runner, tudo roda de uma vez.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Autenticação",
      "description": "Geração do token de acesso. Comece por aqui: o Login guarda o token na variável {{token}}, usada pelas demais requisições.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const dados = pm.response.json().data;",
                  "pm.collectionVariables.set('token', dados.token);",
                  "pm.test('Token do tipo Bearer', () => pm.expect(dados.tipo).to.eql('Bearer'));",
                  "pm.test('Escopos de leitura e escrita', () => pm.expect(dados.escopos).to.eql(['api:leitura', 'api:escrita']));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Troca e-mail e senha por um token Bearer com os escopos api:leitura e api:escrita. Válido por 7 dias.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{senha}}\",\n  \"nome_dispositivo\": \"Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login só leitura",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token_leitura', pm.response.json().data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Cria um segundo token apenas com o escopo api:leitura, usado no exemplo de 403 da pasta 6.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{senha}}\",\n  \"nome_dispositivo\": \"Postman (só leitura)\",\n  \"escopos\": [\"api:leitura\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Usuário do token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/usuario",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuario"
              ]
            },
            "description": "Mostra o usuário dono do token (confere se o token está funcionando)."
          }
        }
      ]
    },
